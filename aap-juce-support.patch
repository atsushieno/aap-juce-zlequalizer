diff --git a/CMakeLists.txt b/CMakeLists.txt
index dc5830f..6211166 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1,6 +1,11 @@
 # 3.24.1 is bundled in Visual Studio 2022 v17.4
 # 3.24.1 is also bundled in CLion as of 2023
 cmake_minimum_required(VERSION 3.24.1)
+
+get_filename_component(app_source "${CMAKE_CURRENT_LIST_DIR}" REALPATH)
+add_subdirectory("${app_source}/../aap-juce" "${CMAKE_CURRENT_BINARY_DIR}/aap-juce" EXCLUDE_FROM_ALL)
+aap_juce_configure(JUCE_SOURCE_DIR JUCE ADOPT_EXISTING_PATCHES)
+
 set (CMAKE_CXX_STANDARD 20)
 
 # This tells cmake we have goodies in the /cmake folder
@@ -55,6 +60,8 @@ if (DEFINED ZL_JUCE_FORMATS)
 else ()
     if (CMAKE_SYSTEM_NAME STREQUAL "Darwin")
         set(FORMATS VST3 AU Standalone)
+    elseif (ANDROID)
+        set(FORMATS Standalone)
     else ()
         set(FORMATS VST3 LV2 Standalone)
     endif ()
@@ -227,3 +234,6 @@ target_link_libraries("${PROJECT_NAME}" PRIVATE SharedCode)
 
 # Pass some config to GA (like our PRODUCT_NAME)
 include(GitHubENV)
+
+
+aap_juce_plugin(TARGET ${PROJECT_NAME})
